###########################################################################

prefix=C:/Apache24
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS LDAP LDAPS MQTT MQTTS POP3 POP3S RTSP SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS brotli HSTS HTTP2 HTTP3 HTTPS-proxy IPv6 Kerberos Largefile libz NativeCA NTLM SPNEGO SSL SSPI threadsafe Unicode UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
License: curl
Copyright: Copyright (C) Daniel Stenberg, <daniel@haxx.se>, et al.
Version: 8.23.0
Source: https://curl.se/download/curl-8.23.0.tar.gz
Requires.private: openssl,zlib,libbrotlidec,libbrotlicommon,libzstd,libnghttp2,libngtcp2,libngtcp2_crypto_ossl,libnghttp3
Libs: -L${libdir} -lcurl
Libs.private: -lssl -lcrypto C:/Apache24/lib/z.lib C:/Apache24/lib/brotlidec.lib C:/Apache24/lib/brotlicommon.lib C:/Apache24/lib/zstd_static.lib C:/Apache24/bin/nghttp2.dll C:/Apache24/bin/ngtcp2.dll C:/Apache24/bin/ngtcp2_crypto_ossl.dll C:/Apache24/bin/ngtcp2.dll -lssl -lcrypto C:/Apache24/bin/nghttp3.dll -lwldap32 -lbcrypt -ladvapi32 -lcrypt32 -lsecur32 -lws2_32 -liphlpapi
Cflags: -I${includedir}
Cflags.private: -DCURL_STATICLIB
Link.ABI: c
